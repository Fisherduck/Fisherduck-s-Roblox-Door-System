local RS = game:GetService("ReplicatedStorage")

local DoorModule = require(RS.DoorModule)

local DoorModel = script.Parent
local LockPrompManger = DoorModel:WaitForChild("Lock/UnlockPromptManager")
local HandlePrompManager = DoorModel:WaitForChild("Open/ClosePromptManager")
local LockPrompt = LockPrompManger:WaitForChild("ProximityPrompt")
local HandlePrompt = HandlePrompManager:WaitForChild("ProximityPrompt")

----------------------------------------

local door = DoorModule.new(DoorModel, "Key1")


LockPrompt.Triggered:Connect(function(player)
	local character = player.Character
	if not character then return end

	local tool = character:FindFirstChildOfClass("Tool")

	if tool then
		door:LockorUnlock(tool.Name, LockPrompt)
	else	
		print(player.Name .. " is not holding anything")
	end
end)	


HandlePrompt.Triggered:Connect(function(player)
	door:OpenorClose(HandlePrompt)
end)
